rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Master bypass for the primary administrator email
    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == "admin@example.com";
    }

    // Check for admin role in the 'users' collection
    function isAdmin() {
      return isMasterAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // --- COLLECTION RULES ---

    // Users collection: Essential for login and role management
    match /users/{userId} {
      // Any signed in user can see basic profiles
      allow get, list: if isSignedIn();
      
      // Creating a profile: only for self-registration or master admin
      allow create: if isOwner(userId) || isMasterAdmin();
      
      // Updating a profile: master admin has full control. 
      // Other admins can update roles/approval for anyone.
      // Owners can only update their own basic info (not role/approval)
      allow update: if isMasterAdmin() || isAdmin() || isOwner(userId);
      
      // Deleting a profile: restricted to admins
      allow delete: if isMasterAdmin() || isAdmin();
    }

    // Global settings: Master admin and approved admins can manage
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Store data: Standard operational collections
    match /stores/{storeId}/{collectionId}/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor');
    }

    // Initialization locks
    match /_init/admin {
      allow read, write: if isSignedIn();
    }
  }
}