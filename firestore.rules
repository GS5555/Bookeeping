rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Master bypass for primary administrator emails
    // This is the "God Mode" that ensures you never get "Permission Denied"
    function isMasterAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@example.com" || 
        request.auth.token.email == "ghanshyam.saini@gmail.com"
      );
    }

    // Check for admin role in the 'users' collection
    function isAdmin() {
      return isMasterAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // --- COLLECTION RULES ---

    // Users collection: Central staff registry
    match /users/{userId} {
      allow get, list: if isSignedIn();
      
      // Creating a profile: self-reg or master admin
      allow create: if isOwner(userId) || isMasterAdmin();
      
      // Updating a profile: Master admins or assigned Admins can modify anyone.
      // Users can only update their own basic details (not role/approval).
      allow update: if isMasterAdmin() || isAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isApproved']));
      
      // Deleting a profile: restricted to master admin or admins
      allow delete: if isMasterAdmin() || isAdmin();
    }

    // Global settings and master data: Categories, Brands, etc.
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Store data: Sales, POs, Inventory, etc.
    match /stores/{storeId}/{collectionId}/{document=**} {
      allow read: if isSignedIn();
      // Allow writes if user is an admin or editor
      allow write: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor');
    }

    // System initialization locks
    match /_init/{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}