/**
 * FIRESTORE SECURITY RULES
 * Standardized for 'users' and 'stores' hierarchy.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to get user data with safety check
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isStaff() {
      return isAdmin() || hasRole('editor') || hasRole('data-entry');
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      // Allow any signed-in user to create their initial profile
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
      
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
      
      match /events/{eventId} {
        allow read, write: if isOwner(userId);
      }
    }

    /**
     * @path /stores/{storeId}/...
     */
    match /stores/{storeId}/{document=**} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    /**
     * @path /settings/global/...
     */
    match /settings/global/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /_init/admin {
      allow read, write: if isSignedIn();
    }
  }
}