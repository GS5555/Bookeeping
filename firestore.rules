rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Master bypass for the primary administrator email
    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == "admin@example.com";
    }

    // Check for admin role in the 'users' collection
    function isAdmin() {
      return isMasterAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // --- COLLECTION RULES ---

    // Users collection: Essential for login and role management
    match /users/{userId} {
      // Users can read any profile to see names, but only owners/admins can write
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow listing users for the management UI
      allow create: if isOwner(userId) || isMasterAdmin();
      allow update: if isMasterAdmin() || isAdmin() || isOwner(userId);
      allow delete: if isMasterAdmin() || isAdmin();
    }

    // Global settings: Master admin and approved admins can manage
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Store data: Everything under /stores/ requires admin or editor status
    match /stores/{storeId}/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor');
    }

    // Initialization locks
    match /_init/admin {
      allow read, write: if isSignedIn();
    }
  }
}