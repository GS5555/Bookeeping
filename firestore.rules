rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the current user is an admin or master account
    function isMasterOrAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ghanshyam.saini@gmail.com' ||
        request.auth.token.email == 'admin@example.com' ||
        request.auth.token.email.lower() == 'ghanshyam.saini@gmail.com' ||
        request.auth.token.email.lower() == 'admin@example.com'
      );
    }

    // Rules for the users collection
    match /users/{userId} {
      // Allow any logged-in user to read profiles
      allow read: if request.auth != null;
      
      // Allow users to create their own profile during signup
      allow create: if request.auth != null;
      
      // Allow admins/master email to update roles, approvals, and delete users
      allow update, delete: if isMasterOrAdmin() || request.auth.uid == userId;
    }

    // Default rule for all store data
    match /stores/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Default rule for settings data
    match /settings/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}