    accessorKey: "name",
    header: "Name",
  },
  {
    accessorKey: "trackingUrl",
    header: "Tracking URL",
    cell: ({ row }) => row.original.trackingUrl || 'N/A'
  },
  {
    id: "actions",
    cell: ({ row }) => <ActionsCell item={row.original} onEdit={options.onEdit} onDelete={options.onDelete} />,
