  {
    accessorKey: "name",
    header: "Name",
  },
   {
    accessorKey: "hsnCode",
    header: "HSN Code",
    cell: ({ row }) => {
        const item = row.original as Category;
        return item.hsnCode || 'N/A';
    }
  },
   {
    accessorKey: "gstRate",
    header: "GST Rate",
    cell: ({ row }) => {
